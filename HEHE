local function slider(parent, label, key, min, max, decimals)
	local wrap = Instance.new("Frame")
	wrap.Size = UDim2.new(1, -6, 0, 36)
	wrap.BackgroundTransparency = 1
	wrap.Parent = parent
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.new(0.55, 0, 0, 14)
	l.Font = Enum.Font.Gotham
	l.TextSize = 12
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextColor3 = DIM
	l.Text = label
	l.Parent = wrap
	local v = Instance.new("TextLabel")
	v.BackgroundTransparency = 1
	v.Size = UDim2.new(0.45, 0, 0, 14)
	v.Position = UDim2.new(0.55, 0, 0, 0)
	v.Font = Enum.Font.Gotham
	v.TextSize = 12
	v.TextXAlignment = Enum.TextXAlignment.Right
	v.TextColor3 = PINK
	v.Parent = wrap
	local bar = Instance.new("TextButton")
	bar.Size = UDim2.new(1, 0, 0, 5)
	bar.Position = UDim2.fromOffset(0, 22)
	bar.BackgroundColor3 = Color3.fromRGB(48, 48, 54)
	bar.Text = ""
	bar.AutoButtonColor = false
	bar.Parent = wrap
	Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)
	local fl = Instance.new("Frame")
	fl.BackgroundColor3 = PINK
	fl.BorderSizePixel = 0
	fl.Size = UDim2.fromScale(math.clamp((S[key] - min) / (max - min), 0, 1), 1)
	fl.Parent = bar
	Instance.new("UICorner", fl).CornerRadius = UDim.new(1, 0)
	local step = decimals == 0 and 1 or 0.1
	local function paint()
		fl.Size = UDim2.fromScale(math.clamp((S[key] - min) / (max - min), 0, 1), 1)
		v.Text = string.format("%." .. decimals .. "f / %." .. decimals .. "f", S[key], max)
	end
	paint()
	painters[key] = paint
	local function setX(x)
		local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		S[key] = math.clamp(math.floor((min + (max - min) * rel) / step + 0.5) * step, min, max)
		paint()
	end
	bar.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then activeSlider = setX setX(i.Position.X) end
	end)
end
