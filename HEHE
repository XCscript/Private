local ringFolder = Instance.new("Folder")
ringFolder.Name = "PexorHubRing"
ringFolder.Parent = workspace
local ring = {}
local RING_N = 32
for i = 1, RING_N do
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = BLUE
	p.Transparency = 1
	p.Size = Vector3.new(0.28, 0.12, 1)
	p.Parent = ringFolder
	ring[i] = p
end

local function placeRing()
	local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not S.Hitbox or not root then
		for _, p in ipairs(ring) do p.Transparency = 1 end
		return
	end
	local r = S.HitboxFov
	local center = root.Position - Vector3.new(0, 2.6, 0)
	local seg = math.max((math.pi * 2 * r) / RING_N, 0.4)
	for i, p in ipairs(ring) do
		local a = (i / RING_N) * math.pi * 2
		local pos = center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		p.Size = Vector3.new(0.28, 0.12, seg * 1.08)
		p.CFrame = CFrame.lookAt(pos, pos + Vector3.new(-math.sin(a), 0, math.cos(a)))
		p.Transparency = 0.05
	end
end

local function tw(o, t, props)
	TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props):Play()
end
local function log(msg)
	table.insert(Logs, 1, os.date("%H:%M:%S") .. "  " .. msg)
	if #Logs > 24 then table.remove(Logs) end
	if outLabel then outLabel.Text = table.concat(Logs, "\n") end
end
local function ensureFolder()
	if isfolder and not isfolder(ROOT) then makefolder(ROOT) end
	if isfolder and not isfolder(FOLDER) then makefolder(FOLDER) end
end
local function configList()
	ensureFolder()
	local names = {}
	if not listfiles then return names end
	local ok, files = pcall(listfiles, FOLDER)
	if not ok or type(files) ~= "table" then return names end
	for _, f in ipairs(files) do
		if not string.find(string.lower(f), "pexorhub", 1, true) then continue end
		local name = f:match("([^/\\]+)%.json$")
		if name and not name:find("%.%.") then names[#names + 1] = name end
	end
	table.sort(names)
	return names
end
local function saveConfig(name)
	ensureFolder()
	name = (name or "main"):gsub("[^%w_%-]", "")
	if name == "" then name = "main" end
	writefile(FOLDER .. "/" .. name .. ".json", HttpService:JSONEncode({settings = S, whitelist = Whitelist}))
	log("saved " .. name)
	return name
end
local function loadConfig(name)
	local data = HttpService:JSONDecode(readfile(FOLDER .. "/" .. name .. ".json"))
	if type(data.settings) == "table" then
		for k, v in pairs(data.settings) do if S[k] ~= nil then S[k] = v end end
	end
	Whitelist = {}
	if type(data.whitelist) == "table" then
		for k, v in pairs(data.whitelist) do Whitelist[k] = v end
	end
	for _, fn in pairs(painters) do fn() end
	log("loaded " .. name)
end
local function openFolder()
	ensureFolder()
	local path
	local ok, files = pcall(listfiles, FOLDER)
	if ok and type(files) == "table" then
		for _, f in ipairs(files) do
			if f:find("^%a:") then path = f:match("^(.*[/\\])") break end
		end
	end
	local tries = {}
	if path then tries[#tries + 1] = path:gsub("/", "\\") end
	pcall(function()
		local base = os.getenv("LOCALAPPDATA")
		if base then tries[#tries + 1] = base .. "\\Xeno\\workspace\\PexorHub\\configs" end
	end)
	for _, pth in ipairs(tries) do
		local ran = false
		pcall(function() os.execute('start "" explorer "' .. pth .. '"') ran = true end)
		if not ran then pcall(function() io.popen('explorer "' .. pth .. '"') ran = true end) end
		if ran then log("opened PexorHub/configs") return end
	end
	if setclipboard then setclipboard(FOLDER) end
	log("folder is PexorHub/configs")
end

