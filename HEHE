local espOn = false
RunService.Heartbeat:Connect(function()
	Camera = workspace.CurrentCamera
	updateHitboxes()
	local needAim = S.AimEnabled or S.SilentOn
	local needEsp = S.BoxESP or S.NameESP or S.HealthESP or S.TracerESP or S.ChamESP
	if not needAim and not needEsp and not S.Speed and not S.Fly and not S.Noclip then
		if aimFov then aimFov.Visible, silentFov.Visible = false, false end
		return
	end
	silentPos = S.SilentOn and pick(S.SilentDist, S.SilentFovOn, S.SilentFovSize, S.SilentPart, S.SilentHealth, S.SilentKnock, S.SilentPred, S.SilentPredX, S.SilentPredY) or nil
	if S.AimEnabled and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) and not overMenu() then
		local pos = pick(S.Distance, S.AimFovOn, S.AimFovSize, S.HitPart, S.HealthCheck, false, S.AimPred, S.PredX, S.PredY)
		if pos then
			if S.AimType == "Camera" then
				Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, pos), math.clamp((S.LockPower or 1) / 100, 0.05, 1))
			else
				moveMouse(pos)
			end
		end
	end
	local char, hum = LP.Character, LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		if S.Speed and hum.WalkSpeed ~= S.Walk then hum.WalkSpeed = S.Walk end
		if S.Fly then
			local root = char:FindFirstChild("HumanoidRootPart")
			if root then
				local mv = Vector3.zero
				if UIS:IsKeyDown(Enum.KeyCode.W) then mv += Camera.CFrame.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.S) then mv -= Camera.CFrame.LookVector end
				root.AssemblyLinearVelocity = mv.Magnitude > 0 and mv.Unit * 55 or Vector3.zero
			end
		end
		if S.Noclip then
			for _, p in ipairs(char:GetChildren()) do
				if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
			end
		end
	end
	if aimFov then
		local mouse = UIS:GetMouseLocation()
		aimFov.Position, aimFov.Radius, aimFov.Visible, aimFov.Filled = mouse, S.AimFovSize, S.AimFovOn, S.AimFovFill
		silentFov.Position, silentFov.Radius, silentFov.Visible, silentFov.Filled = mouse, S.SilentFovSize, S.SilentFovOn, S.SilentFovFill
	end
	if not needEsp then
		if espOn then
			for plr, d in pairs(pool) do
				d.box.Visible, d.text.Visible, d.line.Visible = false, false, false
				setCham(plr, false)
			end
			espOn = false
		end
		return
	end
	espOn = true
	local bottom = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y)
	for _, plr in ipairs(Players:GetPlayers()) do
		local d = slot(plr)
		if plr ~= LP and d and alive(plr) then
			local root = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("Head")
			local head = plr.Character:FindFirstChild("Head") or root
			local top = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.1, 0))
			local bot = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 2.8, 0))
			local on = top.Z > 0
			local h, w = math.abs(bot.Y - top.Y), math.abs(bot.Y - top.Y) * 0.55
			d.box.Visible = on and S.BoxESP
			if d.box.Visible then
				d.box.Size = Vector2.new(w, h)
				d.box.Position = Vector2.new(top.X - w * 0.5, top.Y)
			end
			d.text.Visible = on and (S.NameESP or S.HealthESP)
			if d.text.Visible then
				local bits = {}
				if S.NameESP then bits[#bits + 1] = plr.Name end
				if S.HealthESP then
					local hh = plr.Character:FindFirstChildOfClass("Humanoid")
					if hh then bits[#bits + 1] = tostring(math.floor(hh.Health)) end
				end
				d.text.Text = table.concat(bits, " ")
				d.text.Position = Vector2.new(top.X, top.Y - 14)
			end
			d.line.Visible = on and S.TracerESP
			if d.line.Visible then d.line.From, d.line.To = bottom, Vector2.new(top.X, bot.Y) end
			if S.ChamESP then setCham(plr, true) end
		elseif d then
			d.box.Visible, d.text.Visible, d.line.Visible = false, false, false
		end
	end
end)
