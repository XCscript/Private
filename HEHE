local function alive(plr)
	local c = plr.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	return c and h and h.Health > 0
end
local function partOf(plr, mode)
	local c = plr.Character
	if mode == "Head" then return c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart") end
	if mode == "Body" then return c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") or c:FindFirstChild("HumanoidRootPart") end
	return c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart")
end
local function skipped(plr, healthOn, knockOn)
	if Whitelist[plr.Name] then return true end
	if S.TeamCheck and plr.Team and LP.Team and plr.Team == LP.Team then return true end
	local h = plr.Character:FindFirstChildOfClass("Humanoid")
	if healthOn and h.Health < 15 then return true end
	if knockOn then
		local be = plr.Character:FindFirstChild("BodyEffects")
		local ko = be and be:FindFirstChild("K.O")
		if ko and ko.Value then return true end
	end
	return false
end
local function see(char, part)
	params.FilterDescendantsInstances = {LP.Character, char}
	local hit = workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, params)
	return hit == nil or hit.Instance:IsDescendantOf(char)
end
local function predict(part, use, x, y)
	if not use then return part.Position end
	local vel = part.AssemblyLinearVelocity
	return part.Position + Vector3.new(vel.X * (x / 10), vel.Y * (y / 10), vel.Z * (x / 10))
end
local function pick(maxDist, fovOn, fov, partMode, healthOn, knockOn, pred, px, py)
	local mouse = UIS:GetMouseLocation()
	local bestPos, score = nil, fovOn and fov or 1e9
	local origin = Camera.CFrame.Position
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP and alive(plr) and not skipped(plr, healthOn, knockOn) then
			local part = partOf(plr, partMode)
			if part and (part.Position - origin).Magnitude <= maxDist then
				local world = predict(part, pred, px, py)
				local v, on = Camera:WorldToViewportPoint(world)
				if on and v.Z > 0 then
					local d = (Vector2.new(v.X, v.Y) - mouse).Magnitude
					if d < score and see(plr.Character, part) then score, bestPos = d, world end
				end
			end
		end
	end
	return bestPos
end
local function moveMouse(world)
	local viewport = Camera.ViewportSize
	local screen = Camera:WorldToViewportPoint(world)
	local cur = UIS:GetMouseLocation()
	local dx = math.clamp(screen.X, 8, viewport.X - 8) - cur.X
	local dy = math.clamp(screen.Y, 8, viewport.Y - 8) - cur.Y
	local power = math.clamp((S.LockPower or 1) / 100, 0.04, 1)
	local cap = 5 + power * 52
	dx = math.clamp(dx * power * S.Sensitivity, -cap, cap)
	dy = math.clamp(dy * power * S.Sensitivity, -cap, cap)
	if math.abs(dx) < 0.8 then dx = 0 end
	if math.abs(dy) < 0.8 then dy = 0 end
	if mousemoverel and (dx ~= 0 or dy ~= 0) then mousemoverel(dx, dy) end
end
local function inRing(part)
	local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not root then return false end
	local d = root.Position - part.Position
	return Vector3.new(d.X, 0, d.Z).Magnitude <= S.HitboxFov
end
local function restoreTorsos()
	for part, size in pairs(savedTorso) do
		if part.Parent then part.Size = size part.Transparency = 0 end
		savedTorso[part] = nil
	end
end
local function updateHitboxes()
	placeRing()
	if not S.Hitbox then
		if next(savedTorso) then restoreTorsos() end
		return
	end
	local want = Vector3.new(S.HitboxSize, S.HitboxSize, S.HitboxSize)
	local seen = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		local c = plr ~= LP and plr.Character
		local ut = c and c:FindFirstChild("UpperTorso")
		if ut and ut:IsA("BasePart") and not Whitelist[plr.Name] and inRing(ut) then
			seen[ut] = true
			if not savedTorso[ut] then savedTorso[ut] = ut.Size end
			if ut.Size ~= want then
				ut.Size = want
				ut.CanCollide = false
				ut.Transparency = 0.45
			end
		end
	end
	for part, size in pairs(savedTorso) do
		if not seen[part] then
			if part.Parent then part.Size = size part.Transparency = 0 end
			savedTorso[part] = nil
		end
	end
end

